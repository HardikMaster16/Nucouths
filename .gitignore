node_modules/

# Next.js build output
.next/
out/

# Prisma
prisma/generated/

# Legacy local-filesystem admin uploads — new uploads go to Supabase
# Storage instead (lib/admin/supabase-storage.ts). These directories only
# still exist for scripts/migrate-local-uploads-to-supabase.ts to read from
# on whichever machine originally received the upload; keep the directories
# themselves under version control.
public/uploads/products/*
!public/uploads/products/.gitkeep
public/uploads/banners/*
!public/uploads/banners/.gitkeep

# Misc
.DS_Store
*.log
npm-debug.log*
tsconfig.tsbuildinfo

